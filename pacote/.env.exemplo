# Opcional: copie para .env, na mesma pasta do docker-compose.yml, para mudar algum padrão.
# Versão das imagens (latest = a última do main; ou o sha curto de um commit do main).
WC_VERSAO=latest
# Senhas dos usuários de exemplo.
SEED_ADMIN_SENHA=admin123
SEED_VENDEDOR_SENHA=vendedor123
# Endereço do front (CORS do gateway e do S3).
FRONT_ORIGIN=http://localhost:5173
# Retentativas da SEFAZ simulada (padrão 1 e 5 minutos).
SEFAZ_ESPERAS_RETENTATIVA=1m,5m
