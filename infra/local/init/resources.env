# Nomes dos recursos AWS emulados pelo LocalStack.
# Lido pelos scripts de init e pelos serviços (env_file no docker-compose).

# DynamoDB
TABLE_COUNTERS=counters
TABLE_USERS=users
TABLE_CUSTOMERS=customers
TABLE_PRODUCTS=products
TABLE_INVENTORY=inventory
TABLE_INVENTORY_MOVEMENTS=inventory_movements
TABLE_SALES=sales
TABLE_SALE_ITEMS=sale_items
TABLE_NOTAS_FISCAIS=notas_fiscais
TABLE_NOTAS_ITEMS=notas_items
TABLE_FISCAL_EVENTS=fiscal_events
TABLE_ENTRY_NOTES=entry_notes
TABLE_SUPPLIERS=suppliers

# SQS
QUEUE_CUSTOMER_EVENTS=customer-events-queue
QUEUE_INVENTORY_UPDATES=inventory-updates-queue
QUEUE_SALES_EVENTS=sales-events-queue
QUEUE_CUSTOMER_SALES_EVENTS=customer-sales-events-queue
QUEUE_FISCAL_JOBS=fiscal-jobs-queue
QUEUE_SEFAZ=sefaz-queue
QUEUE_FISCAL_EVENTS=fiscal-events-queue
QUEUE_ENTRY_EVENTS=entry-events-queue
QUEUE_DOCUMENT_EVENTS=document-events-queue
QUEUE_EMAIL=email-queue
QUEUE_FISCAL_DLQ=fiscal-dlq

# SNS
TOPIC_LOW_STOCK=low-stock-alerts-topic
TOPIC_SALES_NOTIFICATIONS=sales-notifications-topic
TOPIC_SYSTEM_NOTIFICATIONS=system-notifications-topic
TOPIC_SALES_EVENTS=sales-events-topic

# S3
BUCKET_XML=wc-xml-storage
BUCKET_DOCUMENTS=wc-documents-bucket
BUCKET_REPORTS=wc-reports-bucket
BUCKET_BACKUPS=wc-backups

# Secrets Manager
SECRET_JWT=wc-jwt-secret
SECRET_REDIS=wc-redis-auth-token
SECRET_SEFAZ_CERT=wc-sefaz-certificate

# SES
SES_SENDER=noreply@wcautopecas.com.br
