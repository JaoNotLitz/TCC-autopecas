# Copie para .env (make up faz isso se .env não existir). Nada aqui é credencial real.
AWS_DEFAULT_REGION=sa-east-1
AWS_REGION=sa-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_ENDPOINT_URL=http://localstack:4566

REDIS_PASSWORD=wc-redis-local

# Senhas dos usuários criados pelo seed do auth-service (perfil local).
SEED_ADMIN_SENHA=admin123
SEED_VENDEDOR_SENHA=vendedor123

# Origem do front (CORS).
FRONT_ORIGIN=http://localhost:5173

# E-mail que recebe o lote mensal de XMLs (POST /api/notas/lote-contador).
CONTADOR_EMAIL=contador@wcautopecas.local

# Destinatários dos alertas por e-mail (separados por vírgula).
ALERTA_ESTOQUE_DESTINATARIOS=compras@wcautopecas.local
OPS_DESTINATARIOS=ops@wcautopecas.local
